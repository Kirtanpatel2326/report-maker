# ─────────────────────────────────────────────────────────────────────────────
# FRIDAY — environment variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── LiveKit ───────────────────────────────────────────────────────────────────
# LiveKit Cloud dashboard → your project URL (wss://…)
LIVEKIT_URL=wss://your-project.livekit.cloud
# LiveKit Cloud → API Keys
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── STT: Sarvam Saaras v3 (default) ──────────────────────────────────────────
# dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key

# ── LLM: Google Gemini 2.5 Flash (default) ───────────────────────────────────
# aistudio.google.com
GOOGLE_API_KEY=your_google_api_key

# ── TTS: OpenAI nova (default) ────────────────────────────────────────────────
# platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# ── Optional: Groq (alternative LLM) ─────────────────────────────────────────
# console.groq.com  —  only needed when LLM_PROVIDER = "groq"
GROQ_API_KEY=

# ── Optional: Deepgram (alternative STT) ─────────────────────────────────────
# console.deepgram.com  —  only needed when STT_PROVIDER = "deepgram"
DEEPGRAM_API_KEY=

# ── Optional: Google Cloud STT ────────────────────────────────────────────────
# Path to GCP service-account JSON — only for STT_PROVIDER = "google"
GOOGLE_APPLICATION_CREDENTIALS=

# ── Optional: Supabase (ticketing tool) ──────────────────────────────────────
SUPABASE_URL=
SUPABASE_API_KEY=

# ── MCP server ────────────────────────────────────────────────────────────────
# Override only if you move the server to a different host/port.
# The agent auto-detects the Windows host IP when running inside WSL.
MCP_HOST=127.0.0.1
MCP_PORT=8000
